# LLM Provider (Required)
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=your_key_here

# Image Providers (Optional, but recommended for Flux quality)
# Black Forest Labs: https://api.bfl.ai/
BFL_API_KEY=your_bfl_key_here

# Fal.ai: https://fal.ai/
FAL_KEY=your_fal_key_here

# Prodia: https://prodia.com/
PRODIA_TOKEN=your_prodia_token_here

# HuggingFace (Optional fallback)
HF_TOKEN=your_hf_token_here

# Stable Horde (Optional fallback; guest key is used if omitted)
STABLE_HORDE_API_KEY=your_stable_horde_key_here

# Together AI (Optional fallback)
TOGETHER_API_KEY=your_together_key_here

# YouTube auto-upload (Optional — see: ffmpeg-ai youtube-setup)
# client_secrets.json → ~/.config/ffmpeg-ai/client_secrets.json
# OAuth token is stored automatically after first run of youtube-setup
